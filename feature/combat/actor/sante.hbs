<div class="sante">

    <div class="header">
        <img class="puce"/>
        <img class="separator"/>
        <label class="title">{{translate "sante"}}</label>
    </div>

    <div class="body">

        <img class="pyramide"/>
        
        <div class="modificateur">

            <div class="physique">
                <img class="circle"/>
                <label class="value">{{document.physicalModifier}}%</label>
                <label class="title">{{translate "physique"}}</label>
            </div>

            <div class="magique">
                <img class="circle"/> 
                <label class="value">{{document.magicalModifier}}%</label>
                <label class="title">{{translate "magique"}}</label>
            </div>

        </div>

        <div class="dommages">

            <label class="title">{{translate "dommages"}}</label>

            {{#if (gt @root.data.ka.terre 9)}}
            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique._5")
                value=@root.data.dommage.physique._5
                class="physique-5"
            }}
            {{/if}}

            {{#if (gt @root.data.ka.terre 4)}}
            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique._4")
                value=@root.data.dommage.physique._4
                class="physique-4"
            }}
            {{/if}}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique._3")
                value=@root.data.dommage.physique._3
                class="physique-3"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique._2")
                value=@root.data.dommage.physique._2
                class="physique-2"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique._1")
                value=@root.data.dommage.physique._1
                class="physique-1"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique._1")
                value=@root.data.dommage.magique._1
                class="magique-1"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique._2")
                value=@root.data.dommage.magique._2
                class="magique-2"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique._3")
                value=@root.data.dommage.magique._3
                class="magique-3"
            }}

        </div>

        <div class="mineure">

            <label class="title">{{translate "mineure"}}</label>

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique.mineure")
                value=@root.data.dommage.physique.mineure
                class="physique"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique.mineure")
                value=@root.data.dommage.magique.mineure
                class="magique"
            }}

        </div>

        <div class="serieuse">

            <label class="title">{{translate "serieuse"}}</label>

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique.serieuse")
                value=@root.data.dommage.physique.serieuse
                class="physique"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique.serieuse")
                value=@root.data.dommage.magique.serieuse
                class="magique"
            }}

        </div>

        <div class="grave">

            <label class="title">{{translate "grave"}}</label>

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique.grave")
                value=@root.data.dommage.physique.grave
                class="physique"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique.grave")
                value=@root.data.dommage.magique.grave
                class="magique"
            }}

        </div>

        <div class="mortelle">

            <label class="title">{{translate "mortelle"}}</label>

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.physique.mortelle")
                value=@root.data.dommage.physique.mortelle
                class="physique"
            }}

            {{> "systems/neph5e/templates/checkbox.hbs"
                name=(concat @root.versionPath ".dommage.magique.mortelle")
                value=@root.data.dommage.magique.mortelle
                class="magique"
            }}

        </div>

    </div>

</div>