<div class="bonus">

    <div class="header">
        <img class="puce"/>
        <img class="separator"/>
        <label class="title">{{translate "bonus"}}</label>
    </div>

    <ol>

        <li>
            <label>{{translate "mouvement"}}</label>
            {{> "systems/neph5e/templates/input.hbs"
                name=(concat @root.versionPath ".bonus.mouvement")
                type="number"
                value=@root.data.bonus.mouvement
            }}
        </li>

        <li>
            <label>{{translate "initiative"}}</label>
            {{> "systems/neph5e/templates/input.hbs"
                name=(concat @root.versionPath ".bonus.initiative")
                type="number"
                value=@root.data.bonus.initiative
            }}
        </li>


        <li>
            <label>{{translate "dommages"}}</label>
            {{> "systems/neph5e/templates/input.hbs"
                name=(concat @root.versionPath ".bonus.dommage")
                type="number"
                value=@root.data.bonus.dommage
            }}
        </li>

        <li>
            <label>{{translate "protection"}}</label>
            {{> "systems/neph5e/templates/input.hbs"
                name=(concat @root.versionPath ".bonus.protection")
                type="number"
                value=@root.data.bonus.protection
            }}
        </li>

    </ol>

</div>