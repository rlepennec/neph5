<main 
    class='tab incarnations'
    data-group='primary'
    data-tab='incarnations'
    data-drop="true">

    {{#if (eq from "figure")}}
    <div class="incarnations-header">

        {{#unless @root.locked}}
        <a class="ajouter-incarnation" data-action="addIncarnation" data-tooltip="{{translate 'ajouterIncarnation'}}"><i class="fa-solid fa-plus"></i></a>
        {{/unless}}

        {{!-- Les compteurs sont portés par l'incarnation courante : sans elle, rien à saisir --}}
        {{#if @root.incarnationCourante}}
        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                class="middle"
                name="{{@root.versionPath}}.pointsIncarnations"
                placeholder="0"
                type="text"
                value="{{@root.compteurs.pointsIncarnations}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "pointsIncarnations"}}</span>
        </div>

        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                name="{{@root.versionPath}}.sapienceDepensee"
                placeholder="0"
                type="text"
                value="{{@root.compteurs.sapienceDepensee}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "sapienceDepensee"}}</span>
        </div>

        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                name="{{@root.versionPath}}.sapience"
                placeholder="0"
                type="text"
                value="{{@root.compteurs.sapience}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "sapienceCourante"}}</span>
        </div>
        {{/if}}

    </div>
    {{/if}}

    {{#if (isEmptyCollection actor.periodes)}}
    <div class="helpPeriode">
        {{#if (eq from "figure")}}
        <label>{{translate "aideIncarnations"}}</label>
        {{else}}
        <label>{{translate "aideHistorique"}}</label>
        {{/if}}
        <i class="fas fa-arrow-alt-circle-down fa-2xl"></i>
    </div>
    {{/if}}

    {{#each actor.periodes as |periode|}}
    {{#unless (and (not ../isGM) (not periode.embedded.actif))}}
    <ol class="periodes item-list">

        <li class="periode draggable item" draggable="true" data-drag="true" data-fsid="{{periode.embedded.fsid}}" data-sid="{{periode.cle}}" data-item-id="{{periode.embedded.id}}">

            <div class="periode-header">

                <img class="puce"/>

                <img class="separator"/>

                <label data-action="openIncarnation" class="periode-name display {{#if periode.embedded.courante}}current{{/if}} {{#unless periode.embedded.actif}}disabled{{/unless}}" data-tooltip="{{periode.original.contexte}}, {{periode.original.aube}}">{{periode.original.name}}{{#if periode.embedded.vecu}} — {{periode.embedded.vecu}}{{/if}}</label>

                <div class="periode-actions">

                    {{#if ../isGM}}
                    <label data-action="activatePeriode" class="{{#if periode.embedded.actif}}fa-solid{{else}}fa-regular{{/if}} fa-fire activate" data-tooltip="{{#if periode.embedded.actif}}{{translate 'desactiver'}}{{else}}{{translate 'activer'}}{{/if}}"></label>
                    {{/if}}

                    {{#unless periode.embedded.courante}}
                    <label data-action="currentPeriode" class="fa-solid fa-thumbtack-angle" data-tooltip="{{translate 'periodeCourante'}}"></label>
                    {{/unless}}

                    {{#if (eq ../editedPeriode periode.cle)}}
                    <label data-action="deletePeriode" class="fas fa-trash delete" data-tooltip="{{translate 'supprimer'}}"></label>
                    {{/if}}

                </div>

            </div>

        </li>

    </ol>
    {{/unless}}
    {{/each}}

</div>