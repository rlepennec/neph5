<main 
    class='tab incarnations'
    data-group='primary'
    data-tab='incarnations'
    data-drop="true">

    {{#if (eq from "figure")}}
    <div class="incarnations-header">

        {{#unless @root.locked}}
        <a class="ajouter-incarnation" data-action="addIncarnation" data-tooltip="{{translate 'ajouterIncarnation'}}"><i class="fa-solid fa-plus"></i></a>
        {{/unless}}

        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                class="middle"
                name="{{@root.versionPath}}.pointsIncarnations"
                placeholder="0"
                type="text"
                value="{{@root.data.pointsIncarnations}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "pointsIncarnations"}}</span>
        </div>

        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                name="{{@root.versionPath}}.sapienceDepensee"
                placeholder="0"
                type="text"
                value="{{@root.data.sapienceDepensee}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "sapienceDepensee"}}</span>
        </div>

        <div class="points tooltip">
            <img class="circle"/>
            <input
                {{#if @root.locked}}disabled{{/if}}
                name="{{@root.versionPath}}.sapience"
                placeholder="0"
                type="text"
                value="{{@root.data.sapience}}"
                data-dtype="Number"/>
            <span class="tooltiptext">{{translate "sapienceCourante"}}</span>
        </div>
        
    </div>
    {{/if}}

    {{#if (isEmptyCollection actor.periodes)}}
    <div class="helpPeriode">
        {{#if (eq from "figure")}}
        <label>{{translate "aideIncarnations"}}</label>
        {{else}}
        <label>{{translate "aideHistorique"}}</label>
        {{/if}}
        <i class="fas fa-arrow-alt-circle-down fa-2xl"></i>
    </div>
    {{/if}}

    {{#each actor.periodes as |periode|}}
    {{#unless (and (not ../isGM) (not periode.embedded.actif))}}
    <ol class="periodes item-list">

        <li class="periode draggable item" draggable="true" data-drag="true" data-fsid="{{periode.embedded.fsid}}" data-sid="{{periode.cle}}" data-item-id="{{periode.embedded.id}}">

            <div class="periode-header">

                <img class="puce" data-action="displayPeriode"/>

                <img class="separator"/>

                <label data-action="openIncarnation" class="periode-name display {{#if periode.embedded.courante}}current{{/if}} {{#unless periode.embedded.actif}}disabled{{/unless}}" data-tooltip="{{periode.original.contexte}}, {{periode.original.aube}}">{{periode.original.name}}{{#if periode.embedded.vecu}} — {{periode.embedded.vecu}}{{/if}}</label>

                <div class="periode-actions">

                    {{#if ../isGM}}
                    <label data-action="activatePeriode" class="{{#if periode.embedded.actif}}fa-solid{{else}}fa-regular{{/if}} fa-fire activate" data-tooltip="{{#if periode.embedded.actif}}{{translate 'desactiver'}}{{else}}{{translate 'activer'}}{{/if}}"></label>
                    {{/if}}

                    {{#unless periode.embedded.courante}}
                    <label data-action="currentPeriode" class="fa-solid fa-thumbtack-angle" data-tooltip="{{translate 'periodeCourante'}}"></label>
                    {{/unless}}

                    {{#if (eq ../editedPeriode periode.cle)}}
                    <label data-action="deletePeriode" class="fas fa-trash delete" data-tooltip="{{translate 'supprimer'}}"></label>
                    {{/if}}

                </div>

            </div>

            <div class="periode-body"
                 {{#unless (or (includes ../elapsedPeriodes periode.cle) (eq ../editedPeriode periode.cle))}}
                 style="display: none;"
                 {{/unless}}>

                {{#unless (isEmptyCollection periode.embedded.actors)}}
                <ol class="members">

                    {{#each periode.embedded.actors as |actor|}}
                    <li class="member actor" data-id="{{actor.id}}">
                    <div class="definition">

                        <i class="fa-solid {{#if actor.newer}}fa-user-plus{{else}}fa-user-minus{{/if}}"></i>

                        <label data-action="openItem" class="name open">{{actor.name}}</label>

                        {{#if (eq ../../editedPeriode ../cle)}}
                        <label class="fas fa-trash delete"></label>
                        {{/if}}

                    </div>
                    </li>
                    {{/each}}

                </ol>
                {{/unless}}

                {{#unless (isEmptyCollection periode.embedded.vecus)}}
                <ol class="vecus">

                    {{#each periode.embedded.vecus as |item|}}
                    <li class="vecu item" data-id="{{item.id}}" data-sid="{{item.sid}}">
                    <div class="definition">

                        <input
                            {{#unless (eq ../../editedPeriode ../cle)}}disabled{{/unless}}
                            class="degre set"
                            type="number"
                            value="{{item.degre}}"
                            data-dtype="Number"/>

                        <label data-action="openItem" class="name open">{{item.name}}</label>

                        {{#if (eq ../../editedPeriode ../cle)}}                
                        <label data-action="deleteEmbedded" class="fas fa-trash delete"></label>
                        {{/if}}

                    </div>
                    </li>
                    {{/each}}

                </ol>
                {{/unless}}

                {{#unless (isEmptyCollection periode.embedded.focus)}}
                <ol class="periode-focus">

                    {{#each periode.embedded.focus as |item|}}
                    <li class="focus item" data-id="{{item.id}}" data-sid="{{item.sid}}">
                    <div class="focus-definition">

                        <a><i class="fas fa-scroll"></i></a>

                        <label data-action="openItem" class="focus-name open">{{item.name}}</label>

                        {{#if (eq ../../editedPeriode ../cle)}}
                        <label data-action="deleteEmbedded" class="fas fa-trash delete"></label>
                        {{/if}}

                    </div>
                    </li>
                    {{/each}}

                </ol>
                {{/unless}}

                {{#unless (isEmptyCollection periode.embedded.capacites)}}
                
                <ol class="periode-focus">

                    {{#each periode.embedded.capacites as |item|}}
                    <li class="focus item" data-id="{{item.id}}" data-sid="{{item.sid}}">
                    <div class="focus-definition">

                        <a><i class="fa-solid fa-pen-fancy"></i></a>

                        <label data-action="openItem" class="focus-name open">{{item.name}}</label>

                        {{#if (eq ../../editedPeriode ../cle)}}
                        <label data-action="deleteEmbedded" class="fas fa-trash delete"></label>
                        {{/if}}

                    </div>
                    </li>
                    {{/each}}

                </ol>
                {{/unless}}

            </div>

        </li>

    </ol>
    {{/unless}}
    {{/each}}

</div>