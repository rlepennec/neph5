<section class="option-root">

    {{> "systems/neph5e/templates/copy-uuid.hbs"}}

    <button type="submit">
        <i class="fa-solid fa-floppy-disk" inert=""></i>
        <span>Sauver</span>
    </button>

    <fieldset>
        <legend>Theme</legend>
        <select name="theme">
            {{#select value}}
            {{#each themes.all as |theme|}}
            <option value="{{theme}}"{{#if (eq . ../themes.current)}} selected="{{theme}}"{{/if}}>{{translate theme}}</option>
            {{/each}}
            {{/select}}
        </select>
    </fieldset>

    <fieldset>
        <legend>Nephilim</legend>

        <label>{{translate "pentacle"}}</label>
        <input type="checkbox" name="nephilim" {{checked nephilim}}/>

        <label>{{translate "magie"}}</label>
        <input type="checkbox" name="magie" {{checked magie}}/>

        <label>{{translate "kabbale"}}</label>
        <input type="checkbox" name="kabbale" {{checked kabbale}}/>

        <label>{{translate "alchimie"}}</label>
        <input type="checkbox" name="alchimie" {{checked alchimie}}/>

        <label>{{translate "analogie"}}</label>
        <input type="checkbox" name="analogie" {{checked analogie}}/>

        <label>{{translate "dracomachie"}}</label>
