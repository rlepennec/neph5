<main 
    class='tab combat'
    data-group='primary'
    data-tab='combat'
    data-drop="true">


    <div class="gauche">

        {{> "systems/neph5e/feature/combat/regles/v5/actor/sante.hbs"}}

        {{> "systems/neph5e/feature/combat/regles/v5/actor/armes.hbs"}}

        {{> "systems/neph5e/feature/combat/regles/v5/actor/armures.hbs"}}

        {{> "systems/neph5e/feature/combat/regles/v5/actor/ressources.hbs" degreEditable=false}}

    </div>

    <div class="droite">

        {{> "systems/neph5e/feature/combat/regles/v5/actor/etats.hbs"}}

        <div class="capacites">

            <div class="header">
                <img class="puce"/>
                <img class="separator"/>
                <label class="title">{{translate "capacites"}}</label>
            </div>

            <ol>

                <li class="capacite esquive" data-id="esquive">
                    <i data-action="editCapacity" class="fa-edit {{#if (eq editedCapacity 'esquive')}}fas{{else}}far{{/if}}"></i>
                    <label {{#unless document.regles.isEsquiveAvailable}}class="undefined"{{/unless}}>{{translate "esquive"}}</label>
                    <i class="fas fa-caret-right"></i>
                    <label>{{document.regles.esquive}}</label>
                </li>

                <li class="capacite lutte" data-id="lutte">
                    <i data-action="editCapacity" class="fa-edit {{#if (eq editedCapacity 'lutte')}}fas{{else}}far{{/if}}"></i>
                    <label {{#unless document.regles.isLutteAvailable}}class="undefined"{{/unless}}>{{translate "lutte"}}</label>
                    <i class="fas fa-caret-right"></i>
                    <label>{{document.regles.lutte}}</label>
                </li>

            </ol>

        </div>

        {{> "systems/neph5e/feature/combat/regles/v5/actor/bonus.hbs"}}

    </div>

</main>