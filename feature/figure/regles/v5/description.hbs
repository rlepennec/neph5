<main 
    class='tab description'
    data-group='primary'
    data-tab='description'>

    {{#if @root.locked}}
    {{{enrichedDescription}}}
    {{else}}
    <prose-mirror
        name="{{@root.versionPath}}.description"
        button="true"
        editable="{{editable}}"
        toggled="false"
        value="{{@root.data.description}}">
        {{{enrichedDescription}}}
    </prose-mirror>
    {{/if}}

</main>