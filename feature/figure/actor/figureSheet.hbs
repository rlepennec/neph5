<section class="actor-root soleil">
{{log .}}
    <aside>

        <img
            src="{{document.img}}"
            data-edit="img"
            data-action="editImage"/>

    </aside>

    <article>

        {{> "systems/neph5e/templates/actor-header.hbs"}}

        <main>

            {{> "systems/neph5e/templates/item-references.hbs"
                title="vecus"
                references=context.vecus
            }}

            <h1>{{translate "description"}}</h1>

            {{#if document.sheet.locked}}
            {{{enrichedDescription}}}
            {{else}}
            <prose-mirror
                name="system.description"
                button="true"
                editable="{{editable}}"
                toggled="false"
                value="{{document.system.description}}">
                {{{enrichedDescription}}}
            </prose-mirror>
            {{/if}}

        </main>

    </article>

</section>
