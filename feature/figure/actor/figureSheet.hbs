<section class="actor-root soleil">
{{log .}}
    <aside>

        <img
            src="{{document.img}}"
            data-edit="img"
            data-action="editImage"/>

        <nav>
            {{#each tabs as |tab|}}
            <div>
                <a data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">{{translate tab.label}}</a>
                <!--
                <img class="sheet-navigation-pin"/>
                <img class="sheet-navigation-hole"/>
                -->
            </div>
            {{/each}}
        </nav>

<!--
        <nav>

            {{> "systems/neph5e/templates/actor-option.hbs"
                title="description"
                tab="description"
            }}

            {{> "systems/neph5e/templates/actor-option.hbs"
                title="vecu"
                tab="vecu"
            }}

        </nav>
-->
    </aside>

    <article>

        {{> "systems/neph5e/templates/actor-header.hbs"}}

        <main>

            {{#each tabs as |tab|}}
            {{log tab}}
            {{#if tab.active}}
                <span>{{translate tab.label}}</span>
            {{/if}}
            {{/each}}




        </main>

    </article>

</section>
