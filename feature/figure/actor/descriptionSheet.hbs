
<section 
    class='tab description active'
    data-group='primary'
    data-tab='description'>
{{log .}}
    {{#if root.document.sheet.locked}}
    {{{root.enrichedDescription}}}
    {{else}}
    <prose-mirror
        name="system.base.description"
        button="true"
        editable="{{root.editable}}"
        toggled="false"
        value="{{root.document.system.base.description}}">
        {{{root.enrichedDescription}}}
    </prose-mirror>
    {{/if}}

</section>

