<section 
    class='tab vecu active'
    data-group='primary'
    data-tab='vecu'>

    {{> "systems/neph5e/templates/item-references.hbs"
        title="vecus"
        references=context.vecus
    }}

    {{#each document.items}}
        {{#if (eq this.type "incarnation")}}
            {{#with (incarnation this) as |i|}}
            {{log 'lksflkjdjf'}}
            {{log i}}
            {{log i.item.name}}
            <div class='incarnation' data-sid="{{i.item.system.sid}}">{{i.vecu.name}}</div>
            {{/with}}
        {{/if}}
    {{/each}}

</section>
