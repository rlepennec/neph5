<section 
    class='tab vecu active'
    data-group='primary'
    data-tab='vecu'>

    {{> "systems/neph5e/templates/item-references.hbs"
        title="vecus"
        references=context.vecus
    }}

    {{#if (eq context.incarnations.length 0)}}
        <div class="expanse" data-drop="true"></div>
    {{else}}
        <div>
            {{#each context.incarnations}}
                <div class='incarnation draggable' data-drag="true" data-fsid="{{fsid}}" data-action="select">{{name}}</div>
            {{/each}}
        </div>
    {{/if}}

</section>
