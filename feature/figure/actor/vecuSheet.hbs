<section 
    class='tab vecu active'
    data-group='primary'
    data-tab='vecu'>

    {{> "systems/neph5e/templates/item-references.hbs"
        title="vecus"
        references=context.vecus
    }}

    {{#each document.items}}
    {{log .}}
        {{#if (eq this.type "incarnation")}}
            <div class='incarnation'>{{this.name}}</div>
        {{/if}}
    {{/each}}

</section>
