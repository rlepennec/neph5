<section 
    class='tab vecu active'
    data-group='primary'
    data-tab='vecu'>

    {{> "systems/neph5e/templates/item-references.hbs"
        title="vecus"
        references=context.vecus
    }}

    {{#each document.items}}
        {{#if (eq this.type "incarnation")}}
            {{#with (incarnation this) as |incarnation|}}
            <div class='incarnation draggable' data-sid="{{incarnation.item.system.sid}}">{{incarnation.vecu.name}}</div>
            {{/with}}
        {{/if}}
    {{/each}}

</section>
