<section 
    class='tab vecu active'
    data-group='primary'
    data-tab='vecu'>

    {{#if (eq context.incarnation null)}}

        <div>
            {{#each context.incarnations}}
                <div class='incarnation draggable' data-drag="true" data-drop="true" data-fsid="{{fsid}}" data-action="select">{{name}}</div>
            {{/each}}
        </div>

        <div class="expanse" data-drop="true"/>

    {{else}}

        <div>{{context.incarnation.name}}</div>

        {{#each context.incarnation.competences as |competence|}}

            <input
                name="system.competence.sapience"
                type="number"
                value="{{competence.sapience}}"
                data-dtype="Number"
                data-fsid="{{competence.fsid}}"
            />

        {{/each}}
<!--
        {{#each context.incarnation.system.base.competences as |competence|}}
            {{#with (getIdentifier competence)}}
                <label class="fas fa-trash"></label>
                <div data-fsid="{{fsid}}">{{name}}</div>



                

                <input
                    name={{fsid}}
                    type="number"
                    value="{{item.degre}}"
                    data-dtype="Number"/>

            {{/with}}
        {{/each}}
-->
        <div data-action="delete" data-delete="incarnation">Delete</div>

        <div data-action="exit" data-exit="incarnation">Exit</div>

    {{/if}}

</section>
