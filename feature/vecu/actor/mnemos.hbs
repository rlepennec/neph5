<section class="item-root">

    <aside style="--background-side: var(--background-side-vecu)"></aside>

    <article>


        <header>

            <input
                name="name"
                type="text"
                value="{{name}}">

        </header>

        <main>

            {{> "systems/neph5e/templates/input.hbs"
                title="degre"
                name="degre"
                value=degre
            }}

            <prose-mirror
                name="description"
                button="true"
                editable="true"
                toggled="false"
                value="{{description}}">
                {{{enrichedDescription}}}
            </prose-mirror>

        </main>

        <footer class="mnemos-footer">
            <button type="submit">
                <i class="fa-solid fa-floppy-disk"></i> Sauver
            </button>
        </footer>

    </article>

</section>