<section class="item-root">

    <aside style="--background-side: var(--background-side-vecu)"></aside>

    <article>

        {{> "systems/neph5e/templates/item-header.hbs"}}

        <main>

            {{> "systems/neph5e/templates/item-select.hbs"
                title="element"
                name="system.item.base.element"
                value=document.system.item.base.element
                options=context.elements
            }}

            {{> "systems/neph5e/templates/item-label.hbs"
                title="periode"
                references=context.periode
            }}

            {{> "systems/neph5e/templates/item-references.hbs"
                title="competences"
                references=context.competences
            }}

            <h1>{{translate "description"}}</h1>

            {{#if document.sheet.locked}}
            {{{enrichedDescription}}}
            {{else}}
            <prose-mirror
                name="system.item.base.description"
                button="true"
                editable="{{editable}}"
                toggled="false"
                value="{{document.system.item.base.description}}">
                {{{enrichedDescription}}}
            </prose-mirror>
            {{/if}}

        </main>

    </article>

</section>
