<main 
    class='tab akasha'
    data-group='primary'
    data-tab='akasha'>

    <div class="column">

        <div class="header">

            <img class="puce"/>

            <img class="separator"/>

            <label class="name">{{translate "akasha"}}</label>

        </div>

        <div class="directions">

            <div class="vaisseau nef tooltip" data-type="nef">
                <img class="activate {{#unless @root.data.akasha.nef.active}}undeveloped{{/unless}}"/>
                <label class="tooltiptext">{{translate "nef"}}</label>
            </div>

            <div class="zenith">
                <img class="circle"/>
                <input
                    {{#if @root.locked}}disabled{{/if}}
                    name="{{@root.versionPath}}.akasha.boussole.zenith"
                    type="text"
                    value="{{@root.data.akasha.boussole.zenith}}"
                    data-dtype="Number"/>
                <label>Zenith +{{getLevel @root.data.akasha.boussole.zenith}}</label>
            </div>

            <div class="orient">
                <img class="circle"/>
                <input
                    {{#if @root.locked}}disabled{{/if}}
                    name="{{@root.versionPath}}.akasha.boussole.orient"
