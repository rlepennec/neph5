<section class="option-root">

    {{> "systems/neph5e/templates/copy-uuid.hbs"}}

    <button type="submit">
        <i class="fa-solid fa-floppy-disk" inert=""></i>
        <span>Sauver</span>
    </button>

    <fieldset>
        <legend>Theme</legend>
        <select name="theme">
            {{#select value}}
            {{#each themes.all as |theme|}}
            <option value="{{theme}}"{{#if (eq . ../themes.current)}} selected="{{theme}}"{{/if}}>{{translate theme}}</option>
            {{/each}}
            {{/select}}
        </select>
    </fieldset>

    <fieldset>
        <legend>Affichage</legend>

        <label>{{translate "chronologieDescendante"}}</label>
        <input type="checkbox" name="chronologieDescendante" {{checked chronologieDescendante}}/>

        <label>{{translate "incarnationsOuvertes"}}</label>
        <input type="checkbox" name="incarnationsOuvertes" {{checked incarnationsOuvertes}}/>

        <label>{{translate "fraterniteActive"}}</label>
        <input type="checkbox" name="fraterniteActive" {{checked active}}/>

    </fieldset>

</section>