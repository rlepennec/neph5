<main
    class='tab science'
    data-group='primary'
    data-tab='ressources'>

    <ol class="cercles">
        {{#each (sciences) as |science|}}
        {{#with (numberOfFocus ../actor science) as |size|}}
        {{#if (gt size 0)}}
        <div class="cercle">
            <div class="header">
                <img class="circle"/>
                <img class="separator"/>
                <div class="cercle-degre">{{size}}</div>
                <div class="cercle-menu">
                    <span class="cercle-name">{{localize (concat "NEPHILIM." science)}}</span>
                </div>
            </div>
            <ol class="all-focus">
                {{#each (focus ../../actor science) as |focus|}}
                <li class="focus item" data-sid="{{focus.original.sid}}">
                    <label data-action="editOriginalItem" class="focus-name open">{{focus.original.name}}</label>
                </li>
                {{/each}}
            </ol>
        </div>
        {{/if}}
        {{/with}}
        {{/each}}
    </ol>

</main>