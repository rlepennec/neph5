<main
    class='tab science'
    data-group='primary'
    data-tab='effectif'>

    <ol class="cercles">
    {{#each actor.membres as |group|}}
        <div class="cercle">
            <div class="header">
                <img class="circle"/>
                <img class="separator"/>
                <div class="cercle-degre">{{group.size}}</div>
                <div class="cercle-menu">
                    <span class="cercle-name">{{#if (eq group.status "membres")}}{{translate "membres"}}{{else}}{{group.status}}{{/if}}</span>
                </div>
            </div>
            <ol class="all-focus">
                {{#each group.membres as |membre|}}
                <li class="focus item" data-id="{{membre.id}}">
                    <a class="icon"><i class="fa-solid fa-user"></i></a>
                    <label data-action="editActor" class="focus-name open">{{membre.name}}</label>
                </li>
                {{/each}}
            </ol>
        </div>
    {{/each}}
    </ol>

</main>