<section class="item-root"s>

    <aside style="--background-side: var(--background-side-competence)"></aside>

    <article>

        {{> "systems/neph5e/templates/item-header.hbs"}}

        <main>

            <h1>{{translate "description"}}</h1>

            {{#if document.sheet.locked}}
            {{{enrichedDescription}}}
            {{else}}
            <prose-mirror
                name="system.item.base.description"
                button="true"
                editable="{{editable}}"
                toggled="false"
                value="{{document.system.item.base.description}}">
                {{{enrichedDescription}}}
            </prose-mirror>
            {{/if}}

        </main>

    </article>

</section>
