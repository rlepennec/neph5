<section>

    <fieldset>
        <legend>Theme</legend>

        <select name="theme">
            {{#select value}}
            {{#each themes.all as |theme|}}
            <option value="{{theme}}"{{#if (eq . ../themes.current)}} selected="{{theme}}"{{/if}}>{{translate theme}}</option>
            {{/each}}
            {{/select}}
        </select>
     </fieldset>

     <input type="checkbox" name="degatAutomatique" checked="{{degatAutomatique}}"/>

    <button type="submit">
        <i class="fa-solid fa-floppy-disk" inert=""></i>
        <span>Sauver</span>
    </button>

</section>