<section class="option-root">

    <button type="submit">
        <i class="fa-solid fa-floppy-disk" inert=""></i>
        <span>Sauver</span>
    </button>

    <fieldset>
        <legend>Theme</legend>
        <select name="theme">
            {{#select value}}
            {{#each themes.all as |theme|}}
            <option value="{{theme}}"{{#if (eq . ../themes.current)}} selected="{{theme}}"{{/if}}>{{translate theme}}</option>
            {{/each}}
            {{/select}}
        </select>
    </fieldset>

    <fieldset>
        <legend>Automatisation</legend>

        <label>{{translate "degatAutomatique"}}</label>
        <input type="checkbox" name="degatAutomatique" {{checked degatAutomatique}}/>

    </fieldset>

</section>