        <div class="etats">

            <div class="header">
                <img class="puce"/>
                <img class="separator"/>
                <label class="title">{{translate "etats"}}</label>
            </div>

        </div>

        {{#if (eq document.type 'figure')}}
        <div class="capacites">

            <div class="header">
                <img class="puce"/>
                <img class="separator"/>
                <label class="title">{{translate "capacites"}}</label>
            </div>

        </div>
        {{/if}}

        <div class="bonus">

            <div class="header">
                <img class="puce"/>
                <img class="separator"/>
                <label class="title">{{translate "bonus"}}</label>
            </div>

        </div>

    </div>
