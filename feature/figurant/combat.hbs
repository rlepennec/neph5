<main 
    class='tab general combat'
    data-group='primary'
    data-tab='general'
    data-drop="true">


    <div class="gauche">

        {{> "systems/neph5e/feature/combat/actor/sante.hbs"}}

        {{> "systems/neph5e/feature/combat/actor/armes.hbs"}}

        {{> "systems/neph5e/feature/combat/actor/armures.hbs"}}

        {{> "systems/neph5e/feature/combat/actor/ressources.hbs" degreEditable=true}}

    </div>

    <div class="droite">

        <div class="caracteristiques">

            <div class="header">
                <img class="puce"/>
                <img class="separator"/>
                <label class="title">{{translate "caracteristiques"}}</label>
            </div>

            <ol>

                <li>
                    <a data-action="rollMenace"><i class="fa-duotone fa-thin fa-dice-d20"></i></a>
                    <label>{{translate "menace"}}</label>
                    {{> "systems/neph5e/templates/input.hbs"
                        name="system.menace"
                        type="number"
                        value=document.system.menace
                    }}
                    <a><i></i></a>
                </li>

                <li>
                    <a data-action="rollKa"><i class="fa-duotone fa-thin fa-dice-d20"></i></a>
                    <label>{{translate "ka"}}</label>
                    {{> "systems/neph5e/templates/input.hbs"
                        name="system.ka"
                        type="number"
                        value=document.system.ka
                    }}
                    <a><i></i></a>
                </li>

                {{#each document.items as |item id|}}
                {{#if (eq item.type 'vecu')}}
                <li data-fsid="{{fsid item}}">
                    <a data-action="rollVecu"><i class="fa-duotone fa-thin fa-dice-d20"></i></a>
                    <label data-action="open">{{item.name}}</label>
                    {{> "systems/neph5e/templates/input.hbs"
                        name=(concat 'items.' (fsid item) '.system.degre')
                        type="number"
                        value=item.system.degre
                    }}
                    <a data-action="delete"><i class="fas fa-trash"></i></a>
                </li>
                {{/if}}
                {{/each}}

            </ol>

        </div>

        {{> "systems/neph5e/feature/combat/actor/etats.hbs"}}

        {{> "systems/neph5e/feature/combat/actor/bonus.hbs"}}

    </div>

</main>