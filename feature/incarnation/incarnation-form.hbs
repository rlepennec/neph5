<section class="item-root style-{{style}} incarnation" data-drop="true">

    <aside></aside>

    <article>

        <header>
            <h1>{{#if periode}}{{periode.name}}{{else}}{{translate "incarnation"}}{{/if}}</h1>
        </header>

        <main>

            {{#unless @root.locked}}
            <div class="barre">
                <a data-action="supprimer" data-tooltip="{{translate 'supprimerIncarnation'}}">
                    <i class="fas fa-trash"></i> {{translate "supprimerIncarnation"}}
                </a>
            </div>
            {{/unless}}

            {{#if nouvelle}}
            <p class="brouillon">{{translate "incarnationBrouillon"}}</p>
            {{/if}}

            {{!-- La période n'est pas un onglet : toujours affichée, en tête --}}
            <h3>{{translate "periode"}}</h3>
            {{#if periode}}
            <div class="ligne periode" data-sid="{{periode.sid}}">
                <img src="{{periode.img}}"/>
                <label data-action="ouvrirPeriode" class="open">{{periode.name}}</label>
                <span class="precision">{{periode.contexte}}{{#if periode.aube}}, {{periode.aube}}{{/if}}</span>
            </div>
            {{/if}}

            {{!-- Ce qui peut être déposé, seulement formulaire déverrouillé. Sans période, c'est
                  elle qu'il faut déposer d'abord. --}}
            {{#unless @root.locked}}
            {{#unless periode}}
            <div class="vide">{{translate "deposerPeriode"}}</div>
            {{/unless}}
            {{#if nouvelle}}
            {{#unless vecus.length}}
            <div class="vide">{{translate "deposerVecu"}}</div>
            {{/unless}}
            {{else}}
            <div class="vide">{{translate "deposerAcquis"}}</div>
            {{/if}}
            {{/unless}}

            {{!-- Un onglet dépliant par catégorie, présent seulement s'il contient quelque chose
                  (voir IncarnationForm.#onglets). --}}
            {{#each onglets as |onglet|}}
            <details class="onglet" data-onglet="{{onglet.cle}}" {{#if onglet.ouvert}}open{{/if}}>

                <summary><h3>{{onglet.titre}}</h3></summary>

                {{#if onglet.vecus}}
                <ol class="liste">
                    {{#each @root.vecus as |vecu|}}
                    <li class="ligne item" data-id="{{vecu.id}}" data-sid="{{vecu.sid}}">
                        <img src="{{vecu.img}}"/>
                        <label {{#if vecu.id}}data-action="ouvrir" class="open"{{/if}}>{{vecu.name}}</label>
                        <span class="precision"></span>
                        <input
                            class="degre"
                            type="number"
                            name="vecus.{{vecu.sid}}"
                            value="{{vecu.degre}}"
                            data-tooltip="{{translate 'degre'}}"
                            {{#if @root.locked}}disabled{{/if}}/>
                        {{#if @root.locked}}
                        <span class="action"></span>
                        {{else}}
                        <a data-action="retirer" class="action fas fa-trash" data-tooltip="{{translate 'supprimer'}}"></a>
                        {{/if}}
                    </li>
                    {{/each}}
                </ol>
                {{/if}}

                {{#if onglet.lignes}}
                <ol class="liste">
                    {{#each onglet.lignes as |item|}}
                    {{> "systems/neph5e/feature/incarnation/incarnation-ligne.hbs" item=item}}
                    {{/each}}
                </ol>
                {{/if}}

                {{!-- Une science occulte : ses cercles, du plus petit au plus grand, chacun suivi de ses focus --}}
                {{#each onglet.cercles as |cercle|}}
                <h4 class="cercle">{{cercle.titre}}</h4>
                <ol class="liste">
                    {{#each cercle.lignes as |item|}}
                    {{> "systems/neph5e/feature/incarnation/incarnation-ligne.hbs" item=item}}
                    {{/each}}
                </ol>
                {{/each}}

            </details>

            {{/each}}

        </main>

    </article>

</section>
