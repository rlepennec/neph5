<section class="item-root" data-drop="true">

    <aside style="--background-side: var(--background-side-periode)"></aside>

    <article>

        {{> "systems/neph5e/templates/item-header.hbs"}}

        <main>

            {{> "systems/neph5e/templates/item-input.hbs"
                title="epoque"
                name="system.base.epoque"
                value=document.system.base.epoque
            }}

            {{> "systems/neph5e/templates/item-input.hbs"
                title="region"
                name="system.base.region"
                value=document.system.base.region
            }}

            {{> "systems/neph5e/templates/item-references.hbs"
                title="vecus"
                references=context.vecus
            }}

            <h1>{{translate "description"}}</h1>

            {{#if document.sheet.locked}}
            {{{enrichedDescription}}}
            {{else}}
            <prose-mirror
                name="system.base.description"
                button="true"
                editable="{{editable}}"
                toggled="false"
                value="{{document.system.base.description}}">
                {{{enrichedDescription}}}
            </prose-mirror>
            {{/if}}

        </main>

    </article>

</section>
