{{!-- Nettoyage : membres de fraternité introuvables (règles v5, voir NettoyageV5). Le contexte est celui de la section. --}}
{{!-- Membres de fraternité introuvables --}}
<details class="section" {{#if nombreMembres}}open{{/if}}>
<summary><h2 class="section">{{localize "NEPHILIM.nettoyageSectionMembres"}} <span class="nombre">({{nombreMembres}})</span></h2></summary>

<div class="aide">
    <p>{{localize "NEPHILIM.nettoyageMembresAide"}}</p>
</div>

{{#if nombreMembres}}

<div class="barre">
    <span class="compte">{{localize "NEPHILIM.nettoyageMembresTrouves"}} {{nombreMembres}}</span>
</div>

<table class="orphelins membres">
    <thead>
        <tr>
            <th>{{localize "NEPHILIM.nettoyageFraternite"}}</th>
            <th>{{localize "NEPHILIM.nettoyagePeriode"}}</th>
            <th>{{localize "NEPHILIM.nettoyageStatut"}}</th>
            <th>{{localize "NEPHILIM.nettoyageIdentifiant"}}</th>
            <th>{{localize "NEPHILIM.nettoyageAction"}}</th>
        </tr>
    </thead>
    <tbody>
        {{#each membres as |membre|}}
        <tr>
            <td>{{membre.fraternite}}</td>
            <td>{{membre.periodeNom}}</td>
            <td>{{membre.statut}}</td>
            <td class="sid">{{membre.sid}}</td>
            <td>
                <select class="rattachement" data-fraternite="{{membre.fraterniteUuid}}" data-sid="{{membre.sid}}" data-periode="{{membre.periode}}">
                    <option value="">{{localize "NEPHILIM.nettoyageNeRienFaire"}}</option>
                    <option value="retirer">{{localize "NEPHILIM.nettoyageRetirer"}}</option>
                    <optgroup label="{{localize "NEPHILIM.nettoyageRattacherA"}}">
                        {{#each ../candidats as |candidat|}}
                        <option value="{{candidat.sid}}">{{candidat.nom}}</option>
                        {{/each}}
                    </optgroup>
                </select>
            </td>
        </tr>
        {{/each}}
    </tbody>
</table>

<div class="actions">
    <button type="button" data-action="rattacher">
        <i class="fas fa-check"></i>
        {{localize "NEPHILIM.nettoyageAppliquer"}}
    </button>
</div>

{{else}}

<p class="aucun">{{localize "NEPHILIM.nettoyageMembresAucun"}}</p>

{{/if}}

</details>
