{{!-- Nettoyage du monde : un traitement par section, chacun avec son aide. --}}
<section class="nettoyage-root">

    <div class="aide">
        <h1>{{localize "NEPHILIM.nettoyageTitreAide"}}</h1>
        <p>{{localize "NEPHILIM.nettoyageIntro"}}</p>
    </div>

    {{!-- Items orphelins. Chaque traitement se plie : il s'ouvre de lui-même s'il a trouvé quelque chose. --}}
    <details class="section" {{#if nombre}}open{{/if}}>
    <summary><h2 class="section">{{localize "NEPHILIM.nettoyageSectionItems"}} <span class="nombre">({{nombre}})</span></h2></summary>

    <div class="aide">
        <p>{{localize "NEPHILIM.nettoyageAide1"}}</p>
        <p>{{localize "NEPHILIM.nettoyageAide2"}}</p>
        <p class="exclusions">{{localize "NEPHILIM.nettoyageAide3"}}</p>
    </div>

    {{#if nombre}}

    <div class="barre">
        <span class="compte">{{localize "NEPHILIM.nettoyageTrouves"}} {{nombre}}</span>
        <a data-action="toutCocher">{{localize "NEPHILIM.nettoyageToutCocher"}}</a>
        <a data-action="toutDecocher">{{localize "NEPHILIM.nettoyageToutDecocher"}}</a>
    </div>

    <table class="orphelins">
        <thead>
            <tr>
                <th class="case"></th>
                <th>{{localize "NEPHILIM.nettoyageActeur"}}</th>
                <th>{{localize "NEPHILIM.nettoyageOrigine"}}</th>
                <th>{{localize "NEPHILIM.nettoyageItem"}}</th>
                <th>{{localize "NEPHILIM.nettoyageType"}}</th>
                <th>{{localize "NEPHILIM.nettoyageIdentifiant"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each orphelins as |orphelin|}}
            <tr>
                <td class="case">
                    <input class="selection" type="checkbox" data-uuid="{{orphelin.uuid}}" checked/>
                </td>
                <td>{{orphelin.acteur}}</td>
                <td>{{orphelin.origine}}</td>
                <td>{{orphelin.item}}</td>
                <td>{{orphelin.type}}</td>
                <td class="sid">{{orphelin.sid}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="actions">
        <button type="button" data-action="supprimer">
            <i class="fas fa-trash"></i>
            {{localize "NEPHILIM.nettoyageSupprimer"}}
        </button>
    </div>

    {{else}}

    <p class="aucun">{{localize "NEPHILIM.nettoyageAucun"}}</p>

    {{/if}}

    </details>

    {{!-- Les sections propres aux règles de la version (voir Regles, nettoyage) --}}
    {{#each sections as |section|}}
    {{> (lookup section 'template') section}}
    {{/each}}

</section>
