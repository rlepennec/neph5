{{!-- Nettoyage du monde : un traitement par section, chacun avec son aide. --}}
<section class="nettoyage-root">

    <div class="aide">
        <h1>{{localize "NEPHILIM.nettoyageTitreAide"}}</h1>
        <p>{{localize "NEPHILIM.nettoyageIntro"}}</p>
    </div>

    {{!-- Items orphelins. Chaque traitement se plie : il s'ouvre de lui-même s'il a trouvé quelque chose. --}}
    <details class="section" {{#if nombre}}open{{/if}}>
    <summary><h2 class="section">{{localize "NEPHILIM.nettoyageSectionItems"}} <span class="nombre">({{nombre}})</span></h2></summary>

    <div class="aide">
        <p>{{localize "NEPHILIM.nettoyageAide1"}}</p>
        <p>{{localize "NEPHILIM.nettoyageAide2"}}</p>
        <p class="exclusions">{{localize "NEPHILIM.nettoyageAide3"}}</p>
    </div>

    {{#if nombre}}

    <div class="barre">
        <span class="compte">{{localize "NEPHILIM.nettoyageTrouves"}} {{nombre}}</span>
        <a data-action="toutCocher">{{localize "NEPHILIM.nettoyageToutCocher"}}</a>
        <a data-action="toutDecocher">{{localize "NEPHILIM.nettoyageToutDecocher"}}</a>
    </div>

    <table class="orphelins">
        <thead>
            <tr>
                <th class="case"></th>
                <th>{{localize "NEPHILIM.nettoyageActeur"}}</th>
                <th>{{localize "NEPHILIM.nettoyageOrigine"}}</th>
                <th>{{localize "NEPHILIM.nettoyageItem"}}</th>
                <th>{{localize "NEPHILIM.nettoyageType"}}</th>
                <th>{{localize "NEPHILIM.nettoyageIdentifiant"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each orphelins as |orphelin|}}
            <tr>
                <td class="case">
                    <input class="selection" type="checkbox" data-uuid="{{orphelin.uuid}}" checked/>
                </td>
                <td>{{orphelin.acteur}}</td>
                <td>{{orphelin.origine}}</td>
                <td>{{orphelin.item}}</td>
                <td>{{orphelin.type}}</td>
                <td class="sid">{{orphelin.sid}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="actions">
        <button type="button" data-action="supprimer">
            <i class="fas fa-trash"></i>
            {{localize "NEPHILIM.nettoyageSupprimer"}}
        </button>
    </div>

    {{else}}

    <p class="aucun">{{localize "NEPHILIM.nettoyageAucun"}}</p>

    {{/if}}

    </details>

    {{!-- Membres de fraternité introuvables --}}
    <details class="section" {{#if nombreMembres}}open{{/if}}>
    <summary><h2 class="section">{{localize "NEPHILIM.nettoyageSectionMembres"}} <span class="nombre">({{nombreMembres}})</span></h2></summary>

    <div class="aide">
        <p>{{localize "NEPHILIM.nettoyageMembresAide"}}</p>
    </div>

    {{#if nombreMembres}}

    <div class="barre">
        <span class="compte">{{localize "NEPHILIM.nettoyageMembresTrouves"}} {{nombreMembres}}</span>
    </div>

    <table class="orphelins membres">
        <thead>
            <tr>
                <th>{{localize "NEPHILIM.nettoyageFraternite"}}</th>
                <th>{{localize "NEPHILIM.nettoyagePeriode"}}</th>
                <th>{{localize "NEPHILIM.nettoyageStatut"}}</th>
                <th>{{localize "NEPHILIM.nettoyageIdentifiant"}}</th>
                <th>{{localize "NEPHILIM.nettoyageAction"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each membres as |membre|}}
            <tr>
                <td>{{membre.fraternite}}</td>
                <td>{{membre.periodeNom}}</td>
                <td>{{membre.statut}}</td>
                <td class="sid">{{membre.sid}}</td>
                <td>
                    <select class="rattachement" data-fraternite="{{membre.fraterniteUuid}}" data-sid="{{membre.sid}}" data-periode="{{membre.periode}}">
                        <option value="">{{localize "NEPHILIM.nettoyageNeRienFaire"}}</option>
                        <option value="retirer">{{localize "NEPHILIM.nettoyageRetirer"}}</option>
                        <optgroup label="{{localize "NEPHILIM.nettoyageRattacherA"}}">
                            {{#each @root.candidats as |candidat|}}
                            <option value="{{candidat.sid}}">{{candidat.nom}}</option>
                            {{/each}}
                        </optgroup>
                    </select>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="actions">
        <button type="button" data-action="rattacher">
            <i class="fas fa-check"></i>
            {{localize "NEPHILIM.nettoyageAppliquer"}}
        </button>
    </div>

    {{else}}

    <p class="aucun">{{localize "NEPHILIM.nettoyageMembresAucun"}}</p>

    {{/if}}

    </details>

    {{!-- Pactes hors du monde de l'ordonnance --}}
    <details class="section" {{#if (or nombrePactes conflitsMondes.length)}}open{{/if}}>
    <summary><h2 class="section">{{localize "NEPHILIM.nettoyageSectionPactes"}} <span class="nombre">({{nombrePactes}})</span></h2></summary>

    <div class="aide">
        <p>{{localize "NEPHILIM.nettoyagePactesAide"}}</p>
    </div>

    {{#each conflitsMondes as |conflit|}}
    <p class="conflit">{{conflit.figure}} : {{localize "NEPHILIM.nettoyagePactesConflit"}} ({{conflit.mondes}})</p>
    {{/each}}

    {{#if nombrePactes}}

    <div class="barre">
        <span class="compte">{{localize "NEPHILIM.nettoyagePactesTrouves"}} {{nombrePactes}}</span>
    </div>

    <table class="orphelins pactes">
        <thead>
            <tr>
                <th class="case"></th>
                <th>{{localize "NEPHILIM.nettoyageActeur"}}</th>
                <th>{{localize "NEPHILIM.nettoyageCreature"}}</th>
                <th>{{localize "NEPHILIM.nettoyageMondeCreature"}}</th>
                <th>{{localize "NEPHILIM.nettoyageMondeOrdonnance"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each pactes as |pacte|}}
            <tr>
                <td class="case">
                    <input class="pacte" type="checkbox" data-uuid="{{pacte.uuid}}" checked/>
                </td>
                <td>{{pacte.figure}}</td>
                <td>{{pacte.creature}}</td>
                <td>{{pacte.mondeCreature}}</td>
                <td>{{pacte.mondeOrdonnance}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="actions">
        <button type="button" data-action="retirerPactes">
            <i class="fas fa-check"></i>
            {{localize "NEPHILIM.nettoyagePactesRetirer"}}
        </button>
    </div>

    {{else}}

    <p class="aucun">{{localize "NEPHILIM.nettoyagePactesAucun"}}</p>

    {{/if}}

    </details>

</section>
