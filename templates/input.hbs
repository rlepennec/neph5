<div class="input">

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <input
        name={{name}}
        {{#if type}}type="{{type}}"{{else}}type="text" {{/if}}
        {{#if class}}class="{{class}}" {{/if}}
        value="{{value}}"
        {{#if (or disabled document.sheet.locked)}} disabled{{/if}}/>

</div>