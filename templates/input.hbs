<div class="input{{#if wide}} wide{{/if}}{{#if dot}} dot{{/if}}">

    {{#if icon}}
    <i class="{{icon}}"></i>
    {{/if}}

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <input
        name="{{name}}"
        {{#if type}}type="{{type}}"{{else}}type="text" {{/if}}
        {{#if class}}class="{{class}}" {{/if}}
        value="{{value}}"
        {{#if tooltip}}data-tooltip="{{tooltip}}"{{/if}}
        {{#if @root.locked}} disabled{{/if}}/>

</div>