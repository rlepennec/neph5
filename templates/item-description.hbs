{{#if title}}
<h1>{{title}}</h1>
{{/if}}
{{#if editable}}
<prose-mirror
    name="system.description"
    button="true"
    editable="{{editable}}"
    toggled="false"
    value="{{document.system.description}}">
    {{{enrichedDescription}}}
</prose-mirror>
{{else}}
{{{enrichedDescription}}}
{{/if}}