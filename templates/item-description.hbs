{{#if title}}
<h1>{{translate title}}</h1>
{{/if}}

{{#if document.sheet.locked}}
{{{enrichedDescription}}}
{{else}}
<prose-mirror
    name="system.description"
    button="true"
    editable="{{editable}}"
    toggled="false"
    value="{{document.system.description}}">
    {{{enrichedDescription}}}
</prose-mirror>
{{/if}}