<section class="option-root">

    {{> "systems/neph5e/templates/copy-uuid.hbs"}}

    <button type="submit">
        <i class="fa-solid fa-floppy-disk" inert=""></i>
        <span>Sauver</span>
    </button>

    <fieldset>
        <legend>Style</legend>
        <select name="style">
            {{#select style.current}}
            {{#each style.all as |s|}}
            <option value="{{s}}">{{translate s}}</option>
            {{/each}}
            {{/select}}
        </select>
    </fieldset>

    {{#if versions.length}}
    <fieldset>
        <legend>{{translate "versionsRegles"}}</legend>
        {{#each versions as |v|}}
        <label>{{translate v.version}}</label>
        <input type="checkbox" name="enabled.{{v.version}}" {{checked v.enabled}}/>
        {{/each}}
    </fieldset>
    {{/if}}

</section>