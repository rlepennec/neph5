

<div class="checkbox{{#if wide}} wide{{/if}}">

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <input

        {{#if document.sheet.locked}}
        class="locked"
        {{/if}}

        {{#if (or (nonNull difficulty) (lookup document.sheet "locked"))}}
            disabled
        {{/if}}

        {{#if value}}
            checked
        {{/if}}

        id="{{name}}"
        name="{{name}}"
        type="checkbox"
        data-dtype="Boolean"/>

    <label for="{{name}}"/>

</div>