<div class="checkbox{{#if wide}} wide{{/if}}{{#if square}} square{{/if}}{{#if class}} {{class}}{{/if}}">

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <input

        {{#if @root.locked}}
        class="locked"
        {{/if}}

        {{#if (or (nonNull difficulty) @root.locked)}}
            disabled
        {{/if}}

        {{#if value}}
            checked
        {{/if}}

        id="{{name}}"
        name="{{name}}"
        type="checkbox"
        data-dtype="Boolean"/>

    <label for="{{name}}"/>

</div>