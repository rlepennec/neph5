{{#if title}}
<h1>{{translate title}}</h1>
{{/if}}

<div class="checkbox">

    <input

        {{#if (or (nonNull difficulty) (lookup document.sheet "locked"))}}
            disabled
        {{/if}}

        {{#if value}}
            checked
        {{/if}}

        id="{{name}}"
        name="{{name}}"
        type="checkbox"
        data-dtype="Boolean"/>

    <label for="{{name}}"/>

</div>