<div class="checkbox{{#if wide}} wide{{/if}}{{#if square}} square{{/if}}{{#if class}} {{class}}{{/if}}">

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <input

        {{#if @root.locked}}
        class="locked"
        {{/if}}

        {{#if (or (nonNull difficulty) @root.locked)}}
            disabled
        {{/if}}

        {{#if value}}
            checked
        {{/if}}

        id="{{@root.document.uuid}}.{{name}}"
        name="{{name}}"
        type="checkbox"
        data-dtype="Boolean"/>

    {{!-- Identifiant préfixé de l'uuid du document : sans lui, deux fiches ouvertes portaient
         les mêmes identifiants, et cliquer une case de l'une cochait celle de l'autre. --}}
    <label for="{{@root.document.uuid}}.{{name}}"/>

</div>