{{#if title}}
<h1>{{translate title}}</h1>
{{/if}}

{{#if locked}}
<p>{{translate value}}</p>
{{else}}
<select name={{name}}>
    {{#select value}}
    {{#each options as |option|}}
    <option value="{{option}}" class="option">{{translate option}}</option>
    {{/each}}
    {{/select}}
</select>
{{/if}}