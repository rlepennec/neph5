{{#if title}}
<h1>{{translate title}}</h1>
{{/if}}

<ul class="column-2">
    {{#each references.collection as |item|}}
    <li data-action="open" data-uuid="{{item.uuid}}" data-id="{{../references.documentName}}.{{../references.type}}.{{item.id}}">
        <i class="fas fa-trash" {{#unless ../document.sheet.locked}}data-action="delete"{{/unless}}></i>
        {{item.name}}
    </li>
    {{/each}}
</ul>