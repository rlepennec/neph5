{{#if title}}
<h1>{{translate title}}</h1>
{{/if}}

<ul class="column-2">
    {{#each references.collection as |item|}}
    <li data-fsid="{{item.fsid}}">
        <i class="fas fa-trash"{{#unless ../document.sheet.locked}} data-action="delete"{{/unless}}></i>
        <span data-action="open">{{item.name}}</span>
    </li>
    {{/each}}
</ul>