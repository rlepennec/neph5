<div class="label{{#if wide}} wide{{/if}}">

    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    <span>
        {{#if (isNull value)}}
            {{translate placeholder}}
        {{else}}
            {{#with (getIdentifier value)}}
                {{name}}
            {{/with}}
        {{/if}}
    </span>
    
</div>