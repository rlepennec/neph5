<h1 class="title">{{translate title}}</h1>

{{#unless (isEmptyCollection values)}}
<ol>

    {{#each values as |item|}}
    <li data-fsid="{{fsid item}}">

        <input
            name="{{../names}}.[{{@index}}]"
            type="hidden"
            value="{{item}}"
            data-dtype="String"/>

        {{#with (concat ../delete " fas fa-trash") as |class|}}
        <a data-action="delete"><i class="{{class}}"></i></a>
        {{/with}}

        {{#with (concat ../edit " hoverable") as |class|}}
        {{#with (getItem ..)}}
        <span data-action="open">{{name}}</span>
        {{/with}}
        {{/with}}

    </li>
    {{/each}}

</ol>
{{/unless}}