<div class="image">

    <img
        {{#if class}}class="{{class}}" {{/if}}
        {{#if title}}title="{{translate title}}" {{/if}}
        {{#if editPath}}data-edit="{{editPath}}" data-action="editImage" {{/if}}
        src="{{src}}"/>

    {{#if glow}}
    <div class="glow"></div>
    {{/if}}

</div>