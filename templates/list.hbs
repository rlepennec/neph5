<h1 class="title">{{translate title}}</h1>

{{#unless (isEmptyCollection values)}}
<ol>

    {{#each values as |item|}}
    <li data-fsid="{{fsid item}}">

        <input
            name="{{../names}}.[{{@index}}]"
            type="hidden"
            value="{{item}}"
            data-dtype="String"/>

        <a data-action="delete"><i class="fas fa-trash"></i></a>

        {{#with (getIdentifier .)}}
        <span class="hoverable" data-action="open">{{name}}</span>
        {{/with}}

    </li>
    {{/each}}

</ol>
{{/unless}}