<div class="list">
    
    {{#if title}}
    <h1>{{translate title}}</h1>
    {{/if}}

    {{#unless (isEmptyCollection values)}}
    <ol
        {{#if class}}
        class="{{class}}"
        {{/if}}>

        {{#each values as |item|}}
        <li data-fsid="{{fsid item}}">

            <input
                name="{{../names}}.[{{@index}}]"
                type="hidden"
                value="{{item}}"
                data-dtype="String"/>

            <a data-action="delete"><i class="fas fa-trash"></i></a>

            {{#with (getIdentifier .)}}
            <span class="hoverable" data-action="open">{{name}}</span>
            {{/with}}

        </li>
        {{/each}}

    </ol>
    {{/unless}}

</div>